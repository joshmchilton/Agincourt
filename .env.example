# Copy this file to .env and fill in the values. .env is ignored by git.

# Supabase: Project Settings > API Keys in the Supabase dashboard. Use the
# secret key (sb_secret_...). It stays on the server and never reaches the
# browser.
SUPABASE_URL=https://ehnohuqxqbbmfclrwqug.supabase.co
SUPABASE_SECRET_KEY=

# Anthropic API key for writing campaign emails with `npm start`. Not needed
# for `npm run start:local`, which uses your Claude Code sign-in.
ANTHROPIC_API_KEY=
